<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Gaze CRAP Report</title>
<style>
*,*::before,*::after{box-sizing:border-box}body{margin:0;padding:24px;font-family:system-ui,-apple-system,sans-serif;font-size:14px;line-height:1.5;color:#1a1a2e;background:#fafbfc}h1{font-size:1.5em;margin:0 0 16px}h2{font-size:1.15em;margin:24px 0 10px}h3{font-size:1em;margin:16px 0 6px}.summary,.diagnostic,.empty,.status{margin:0 0 16px;padding:12px 16px;border-radius:6px;background:#f0f4f8}.diagnostic{border-left:4px solid #ca8a04;background:#fffbeb}.empty{text-align:center;color:#4b5563}.status.pass{border-left:4px solid #15803d;background:#f0fdf4}.status.fail{border-left:4px solid #b91c1c;background:#fef2f2}.metrics{display:grid;grid-template-columns:repeat(auto-fit,minmax(160px,1fr));gap:8px;margin:0 0 12px}.metric{padding:10px 12px;border:1px solid #e2e8f0;border-radius:6px;background:#fff}.metric strong{display:block;font-size:1.1em}.label{color:#64748b;font-size:.82em}table{width:100%;border-collapse:collapse;font-size:.9em;margin-top:8px}th{text-align:left;padding:6px 8px;background:#f8fafc;border-bottom:2px solid #e2e8f0;color:#64748b}td{padding:6px 8px;border-bottom:1px solid #f1f5f9;vertical-align:top}code{font-family:ui-monospace,monospace}.muted{color:#64748b}.unavailable{font-style:italic;color:#92400e}ul{margin:6px 0 0;padding-left:22px}.scroll{overflow-x:auto}
</style>
</head>
<body>
<main>
<h1>Gaze CRAP Report</h1>
{{- if eq (len .Scores) 0}}<div class="empty">No functions were analyzed.</div>{{end}}
<section aria-labelledby="summary"><h2 id="summary">Summary</h2><div class="metrics">
<div class="metric"><span class="label">Functions analyzed</span><strong>{{.Summary.TotalFunctions}}</strong></div>
<div class="metric"><span class="label">Average complexity</span><strong>{{printf "%.1f" .Summary.AvgComplexity}}</strong></div>
<div class="metric"><span class="label">Average line coverage</span><strong>{{printf "%.1f%%" .Summary.AvgLineCoverage}}</strong></div>
<div class="metric"><span class="label">Average CRAP</span><strong>{{printf "%.1f" .Summary.AvgCRAP}}</strong></div>
<div class="metric"><span class="label">CRAPload</span><strong>{{.Summary.CRAPload}}</strong><span class="muted">threshold {{printf "%.1f" .Summary.CRAPThreshold}}</span></div>
{{- if .Summary.GazeCRAPload.Available}}<div class="metric"><span class="label">GazeCRAPload</span><strong>{{.Summary.GazeCRAPload.Value}}</strong>{{if .Summary.GazeCRAPThreshold.Available}}<span class="muted">threshold {{printf "%.1f" .Summary.GazeCRAPThreshold.Value}}</span>{{end}}</div>{{end}}
{{- if .Summary.AvgGazeCRAP.Available}}<div class="metric"><span class="label">Average GazeCRAP</span><strong>{{printf "%.1f" .Summary.AvgGazeCRAP.Value}}</strong></div>{{end}}
{{- if .Summary.AvgContractCoverage.Available}}<div class="metric"><span class="label">Average contract coverage</span><strong>{{printf "%.1f%%" .Summary.AvgContractCoverage.Value}}</strong></div>{{end}}
</div></section>
{{- if .Summary.SSADegradedPackages}}<section class="diagnostic" aria-label="SSA degradation"><strong>SSA analysis degraded.</strong> Contract coverage and GazeCRAP metrics are partial.<ul>{{range .Summary.SSADegradedPackages}}<li>{{.}}</li>{{end}}</ul></section>{{end}}
{{- if .Summary.Quadrants}}<section aria-labelledby="quadrants"><h2 id="quadrants">Quadrant Breakdown</h2><div class="metrics">{{range .Summary.Quadrants}}<div class="metric"><span class="label">{{.Name}}</span><strong>{{.Count}}</strong></div>{{end}}</div></section>{{end}}
{{- if .Summary.Remediations}}<section aria-labelledby="remediations"><h2 id="remediations">Remediation Breakdown</h2><div class="metrics">{{range .Summary.Remediations}}<div class="metric"><span class="label">{{.Name}}</span><strong>{{.Count}}</strong></div>{{end}}</div></section>{{end}}
{{- if .Scores}}<section aria-labelledby="scores"><h2 id="scores">Function Scores</h2><div class="scroll"><table><thead><tr><th>Function</th><th>Location</th><th>Complexity</th><th>Line coverage</th><th>CRAP</th><th>Contract coverage</th><th>GazeCRAP</th><th>Quadrant</th><th>Fix strategy</th><th>Diagnostic</th></tr></thead><tbody>
{{- range .Scores}}<tr><td><strong>{{.Function}}</strong>{{if .Package}}<br><span class="muted">{{.Package}}</span>{{end}}</td><td><code>{{.File}}:{{.Line}}</code></td><td>{{.Complexity}}</td><td>{{printf "%.1f%%" .LineCoverage}}</td><td>{{printf "%.1f" .CRAP}}</td><td>{{if .ContractCoverage.Available}}{{printf "%.1f%%" .ContractCoverage.Value}}{{else}}<span class="unavailable">Unavailable</span>{{end}}</td><td>{{if .GazeCRAP.Available}}{{printf "%.1f" .GazeCRAP.Value}}{{else}}<span class="unavailable">Unavailable</span>{{end}}</td><td>{{if .Quadrant}}{{.Quadrant}}{{else}}<span class="unavailable">Unavailable</span>{{end}}</td><td>{{if .FixStrategy}}{{.FixStrategy}}{{else}}—{{end}}</td><td>{{if .ContractCoverageReason}}{{.ContractCoverageReason}}{{if .EffectConfidenceAvailable}} (confidence {{.EffectConfidenceMin}}–{{.EffectConfidenceMax}}){{end}}{{else}}—{{end}}</td></tr>{{end}}
</tbody></table></div></section>{{end}}
{{- if .Summary.RecommendedActions}}<section aria-labelledby="actions"><h2 id="actions">Recommended Actions</h2><ol>{{range .Summary.RecommendedActions}}<li><strong>{{.Strategy}}</strong>: {{.Function}} <span class="muted">({{.File}}:{{.Line}}, CRAP {{printf "%.1f" .CRAP}}{{if .GazeCRAP.Available}}, GazeCRAP {{printf "%.1f" .GazeCRAP.Value}}{{end}}, complexity {{.Complexity}}{{if .Quadrant}}, {{.Quadrant}}{{end}})</span></li>{{end}}</ol></section>{{end}}
{{- if .Summary.WorstCRAP}}<section aria-labelledby="worst-crap"><h2 id="worst-crap">Worst CRAP Offenders</h2><ol>{{range .Summary.WorstCRAP}}<li>{{.Function}} — {{printf "%.1f" .CRAP}} <span class="muted">({{.File}}:{{.Line}})</span></li>{{end}}</ol></section>{{end}}
{{- if .Summary.WorstGazeCRAP}}<section aria-labelledby="worst-gaze-crap"><h2 id="worst-gaze-crap">Worst GazeCRAP Offenders</h2><ol>{{range .Summary.WorstGazeCRAP}}<li>{{.Function}} — {{if .GazeCRAP.Available}}{{printf "%.1f" .GazeCRAP.Value}}{{else}}<span class="unavailable">Unavailable</span>{{end}} <span class="muted">({{.File}}:{{.Line}})</span></li>{{end}}</ol></section>{{end}}
{{- with .Comparison}}<section aria-labelledby="comparison"><h2 id="comparison">Baseline Comparison</h2><div class="status {{if .Passed}}pass{{else}}fail{{end}}"><strong>{{if .Passed}}PASS{{else}}FAIL{{end}}</strong></div><div class="metrics">
<div class="metric"><span class="label">Regressions</span><strong>{{.Regressions}}</strong></div><div class="metric"><span class="label">Improvements</span><strong>{{.Improvements}}</strong></div><div class="metric"><span class="label">New functions</span><strong>{{.NewFunctions}}</strong></div><div class="metric"><span class="label">New violations</span><strong>{{.NewViolations}}</strong></div><div class="metric"><span class="label">Removed functions</span><strong>{{.RemovedFunctions}}</strong></div><div class="metric"><span class="label">Unchanged</span><strong>{{.Unchanged}}</strong></div><div class="metric"><span class="label">Delta epsilon</span><strong>{{printf "%.1f" .Epsilon}}</strong></div><div class="metric"><span class="label">New-function thresholds</span><strong>CRAP {{printf "%.1f" .NewFunctionThreshold}}</strong><span class="muted">GazeCRAP {{printf "%.1f" .NewFunctionGazeCRAPThreshold}}</span></div></div>
{{- if .RegressionDeltas}}<h3>Regressions</h3>{{template "deltas" .RegressionDeltas}}{{end}}
{{- if .ImprovementDeltas}}<h3>Improvements</h3>{{template "deltas" .ImprovementDeltas}}{{end}}
{{- if .NewViolation}}<h3>New Functions (violations)</h3>{{template "comparison-scores" .NewViolation}}{{end}}
{{- if .New}}<h3>New Functions</h3>{{template "comparison-scores" .New}}{{end}}
{{- if .Removed}}<h3>Removed Functions</h3>{{template "comparison-scores" .Removed}}{{end}}
</section>{{end}}
</main>
</body>
</html>
{{- define "deltas"}}<div class="scroll"><table><thead><tr><th>Function</th><th>Location</th><th>Baseline CRAP</th><th>Current CRAP</th><th>CRAP delta</th><th>Baseline GazeCRAP</th><th>Current GazeCRAP</th><th>GazeCRAP delta</th></tr></thead><tbody>{{range .}}<tr><td>{{.Function}}{{if .Package}}<br><span class="muted">{{.Package}}</span>{{end}}</td><td><code>{{.File}}:{{.Line}}</code></td><td>{{printf "%.1f" .BaselineCRAP}}</td><td>{{printf "%.1f" .CurrentCRAP}}</td><td>{{printf "%+.1f" .CRAPDelta}}</td><td>{{if .BaselineGazeCRAP.Available}}{{printf "%.1f" .BaselineGazeCRAP.Value}}{{else}}<span class="unavailable">Unavailable</span>{{end}}</td><td>{{if .CurrentGazeCRAP.Available}}{{printf "%.1f" .CurrentGazeCRAP.Value}}{{else}}<span class="unavailable">Unavailable</span>{{end}}</td><td>{{if .GazeCRAPDelta.Available}}{{printf "%+.1f" .GazeCRAPDelta.Value}}{{else}}<span class="unavailable">Unavailable</span>{{end}}</td></tr>{{end}}</tbody></table></div>{{end}}
{{- define "comparison-scores"}}<div class="scroll"><table><thead><tr><th>Function</th><th>Location</th><th>CRAP</th><th>GazeCRAP</th></tr></thead><tbody>{{range .}}<tr><td>{{.Function}}{{if .Package}}<br><span class="muted">{{.Package}}</span>{{end}}</td><td><code>{{.File}}:{{.Line}}</code></td><td>{{printf "%.1f" .CRAP}}</td><td>{{if .GazeCRAP.Available}}{{printf "%.1f" .GazeCRAP.Value}}{{else}}<span class="unavailable">Unavailable</span>{{end}}</td></tr>{{end}}</tbody></table></div>{{end}}
